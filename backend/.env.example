# ============================================================================
# Winnie The Gym — Backend .env template
# Copiar a `backend/.env` y rellenar los valores según el entorno.
# En producción, cargar como env vars en Render (ver docs/deploy.md).
# ============================================================================

# ---- Django core -----------------------------------------------------------
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://frontend:5173
CSRF_TRUSTED_ORIGINS=

# ---- PostgreSQL ------------------------------------------------------------
DB_NAME=winnie_gym_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ---- Redis -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---- MongoDB ---------------------------------------------------------------
MONGO_URI=mongodb://admin:admin@mongo:27017/
MONGO_DB_NAME=winnie_gym_logs
MONGO_USER=admin
MONGO_PASSWORD=admin
MONGO_RETENTION_DAYS=90

# ---- QR dinámico -----------------------------------------------------------
QR_SECRET_KEY=REPLACE_WITH_OUTPUT_OF: python -c "import secrets; print(secrets.token_hex(32))"
QR_TOKEN_EXPIRATION_SECONDS=30

# ---- Frontend --------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---- Google OAuth ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- MercadoPago (Sandbox) -------------------------------------------------
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_APP_ID=
MP_NGROK_URL=

# ---- Emails: Mailtrap (Anymail HTTP) --------------------------------------
EMAIL_BACKEND=anymail.backends.mailtrap.EmailBackend
MAILTRAP_API_TOKEN=
DEFAULT_FROM_EMAIL=Winnie The Gym <hello@demomailtrap.co>
EMAIL_REPLY_TO=

# ---- Emails: Gmail SMTP (fallback) ----------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---- Celery ----------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Logging ---------------------------------------------------------------
LOG_FORMAT=json
LOG_LEVEL=INFO

# ---- Sentry (opt-in) -------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---- Supabase Storage (solo producción) -----------------------------------
# En dev, FileSystemStorage sirve para MEDIA local. En prod, DEFAULT_FILE_STORAGE
# apunta a apps.common.storages.SupabaseMediaStorage y estas vars son requeridas.
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=fichas-medicas
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_PUBLIC_URL_BASE=

# ---- Security (solo producción) -------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

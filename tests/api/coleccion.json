                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Socio\",\n  \"apellido\": \"Duplicado\",\n  \"email\": \"dup.{{$timestamp}}@test.local\",\n  \"dni\": \"{{test_dni}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/members/socios/",
              "host": ["{{base_url}}"],
              "path": ["api", "members", "socios", ""]
            },

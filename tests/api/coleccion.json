                  "pm.test('id is unchanged', function () {",
                  "  var data = pm.response.json();",
                  "  pm.expect(String(data.id)).to.eql(String(pm.environment.get('socio_id')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"+5493519999999\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/members/socios/{{socio_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "members", "socios", "{{socio_id}}", ""]
            },
            "description": "Partial update — change phone number."
          }
        }
      ]
    },
    {
      "name": "Negative Tests",
      "description": "400 / 401 scenarios to validate authorization and input validation.",
      "item": [
        {
          "name": "Crear plan sin token — 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Response has authentication error', function () {",
                  "  var data = pm.response.json();",
                  "  pm.expect(data.detail || data.code).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Plan sin auth\",\n  \"precio\": 10000,\n  \"duracion_dias\": 30\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/memberships/planes/",
              "host": ["{{base_url}}"],
              "path": ["api", "memberships", "planes", ""]
            },
            "description": "POST without Authorization header — expects 401."
          }
        },
        {
          "name": "Crear plan con precio negativo — 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Response has validation error for precio', function () {",
                  "  var data = pm.response.json();",
                  "  // The error could be under 'precio' or 'non_field_errors'",
                  "  var hasError = data.precio || data.non_field_errors || data.detail;",
                  "  pm.expect(hasError).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Plan Invalido\",\n  \"precio\": -500,\n  \"duracion_dias\": 30\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/memberships/planes/",
              "host": ["{{base_url}}"],
              "path": ["api", "memberships", "planes", ""]
            },
            "description": "POST with negative precio — expects 400 validation error."
          }
        },
        {
          "name": "Crear socio sin token — 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Response has authentication error', function () {",
                  "  var data = pm.response.json();",
                  "  pm.expect(data.detail || data.code).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"No Auth\",\n  \"apellido\": \"Test\",\n  \"email\": \"noauth@test.local\",\n  \"dni\": \"12345678\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/members/socios/",
              "host": ["{{base_url}}"],
              "path": ["api", "members", "socios", ""]
            },
            "description": "POST socios without Authorization header — expects 401."
          }
        },
        {
          "name": "Crear socio con DNI duplicado — 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Response has validation error for dni', function () {",
                  "  var data = pm.response.json();",
